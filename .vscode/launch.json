{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/KrustyKrab.Api/bin/Debug/net10.0/KrustyKrab.Api.dll",
      "cwd": "${workspaceFolder}/src/KrustyKrab.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5160"
      },
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Attach to API",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
