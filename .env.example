# Copy to .env and fill in. .env is gitignored; never commit real values.
# No quotes around values: docker --env-file passes them through literally.

# Used by the MySQL container (docker run --env-file .env)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=mydb

# Used by the .NET apps
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=mydb;Uid=root;Pwd=;
